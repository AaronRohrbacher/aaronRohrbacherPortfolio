# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local

# Amazon Connect widget credentials
NEXT_PUBLIC_CONNECT_INSTANCE_ID=
NEXT_PUBLIC_CONNECT_SNIPPET_ID=

# Amazon Connect IaC (used by sst.config.ts to deploy flows + Lambdas)
AWS_ACCOUNT_ID=
CONNECT_INSTANCE_ID=       # same value as NEXT_PUBLIC_CONNECT_INSTANCE_ID
CONNECT_AGENT_ID=          # agent ID from Connect console (Users > your user)
CONNECT_QUEUE_ID=          # queue ID from Connect console (Routing > Queues)
CONNECT_SNIPPET_ID=        # same value as NEXT_PUBLIC_CONNECT_SNIPPET_ID
CONNECT_SECURITY_KEY=      # 44-char security key from Connect widget config (JWT signing)
CONNECT_WIDGET_ID=         # widget UUID from Connect snippet (4th arg of IIFE)

# Google Calendar (schedule-call Lambda)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=      # obtain via: node scripts/google-oauth.mjs
CALENDAR_EMAIL=

# Admin panel password (for /admin)
NEXT_PUBLIC_ADMIN_PASSWORD=

# Email (Resend API key for contact form)
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# OpenAI (for Resume "Ask AI" chat and Contact page chat)
OPENAI_API_KEY=

# Music S3 bucket (musicsforyou, us-east-2)
AWS_ACCESS_KEY_ID_MUSIC=
AWS_SECRET_ACCESS_KEY_MUSIC=

# Cognito (auto-filled by SST in prod; set manually for local dev after first deploy)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_AWS_REGION=us-east-2

# DynamoDB table name (auto-filled by SST in prod; set manually for local dev)
MUSIC_TABLE_NAME=

# Music CloudFront CDN domain (auto-filled by SST; set manually for local dev)
MUSIC_CDN_DOMAIN=

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=
