    "hash": {}
  },
  "Actions": [

    {
      "Parameters": { "Text": "Thank you for visiting Aaron's portfolio, we appreciate you taking the time. I'm A-A-bot, Aaron's digital assistant. One moment while I contact Aaron for you..." },
      "Identifier": "greeting",
      "Type": "MessageParticipant",
      "Transitions": { "NextAction": "check-online", "Errors": [{ "NextAction": "check-online", "ErrorType": "NoMatchingError" }] }
    },

    {
      "Parameters": { "MetricType": "NumberOfAgentsOnline", "AgentId": "arn:aws:connect:us-west-2:{{AWS_ACCOUNT_ID}}:instance/{{CONNECT_INSTANCE_ID}}/agent/{{CONNECT_AGENT_ID}}" },
      "Identifier": "check-online",
      "Type": "CheckMetricData",
      "Transitions": {
        "NextAction": "offline-menu",
        "Conditions": [{ "NextAction": "online-menu", "Condition": { "Operator": "NumberGreaterThan", "Operands": ["0"] } }],
        "Errors": [
          { "NextAction": "offline-menu", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "offline-menu", "ErrorType": "NoMatchingError" }
        ]
      }
    },

    {
      "Parameters": {
        "Text": "Looks like he's online and ready to take your call! Would you like to:\n\n1. Chat with Aaron (the human one) live right here?\n2. Start a voice call with Aaron? It runs right in this chat box, and uses your device's microphone and speakers.\n3. Start a video call with Aaron? It runs right in this chat box, and uses your device's microphone, camera, and speakers.\n4. Leave Aaron a message? I'll e-mail it to him.\n5. Schedule a 30-minute call for a more convenient time for you?",
        "LexV2Bot": { "AliasArn": "{{LEX_MENU_BOT_ARN}}" }
      },
      "Identifier": "online-menu",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "offline-menu",
        "Conditions": [
          { "NextAction": "connecting-msg",     "Condition": { "Operator": "Equals", "Operands": ["SelectOne"] } },
          { "NextAction": "set-voice",          "Condition": { "Operator": "Equals", "Operands": ["SelectTwo"] } },
          { "NextAction": "set-video",          "Condition": { "Operator": "Equals", "Operands": ["SelectThree"] } },
          { "NextAction": "store-choice-msg",   "Condition": { "Operator": "Equals", "Operands": ["SelectFour"] } },
          { "NextAction": "store-choice-sched", "Condition": { "Operator": "Equals", "Operands": ["SelectFive"] } }
        ],
        "Errors": [
          { "NextAction": "offline-menu", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "offline-menu", "ErrorType": "NoMatchingError" },
          { "NextAction": "offline-menu", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "callType": "voice" } }, "Identifier": "set-voice", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "connecting-msg", "Errors": [{ "NextAction": "connecting-msg", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Attributes": { "callType": "video" } }, "Identifier": "set-video", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "connecting-msg", "Errors": [{ "NextAction": "connecting-msg", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Text": "Connecting you now — hang on a sec." }, "Identifier": "connecting-msg", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "set-queue", "Errors": [{ "NextAction": "set-queue", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "QueueId": "arn:aws:connect:us-west-2:{{AWS_ACCOUNT_ID}}:instance/{{CONNECT_INSTANCE_ID}}/queue/{{CONNECT_QUEUE_ID}}" }, "Identifier": "set-queue", "Type": "UpdateContactTargetQueue",
      "Transitions": { "NextAction": "transfer-queue", "Errors": [{ "NextAction": "offline-menu", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": {}, "Identifier": "transfer-queue", "Type": "TransferContactToQueue",
      "Transitions": { "NextAction": "offline-menu", "Errors": [{ "NextAction": "offline-menu", "ErrorType": "QueueAtCapacity" }, { "NextAction": "offline-menu", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": {
        "Text": "I'm sorry, Aaron has stepped away. Can I:\n\n1. Take a message? I'll e-mail it to him.\n2. Schedule a 30-minute call with Aaron at a convenient time for you?",
        "LexV2Bot": { "AliasArn": "{{LEX_MENU_BOT_ARN}}" }
      },
      "Identifier": "offline-menu",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "partial-notify",
        "Conditions": [
          { "NextAction": "store-choice-msg",   "Condition": { "Operator": "Equals", "Operands": ["SelectOne"] } },
          { "NextAction": "store-choice-sched", "Condition": { "Operator": "Equals", "Operands": ["SelectTwo"] } }
        ],
        "Errors": [
          { "NextAction": "partial-notify", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "partial-notify", "ErrorType": "NoMatchingError" },
          { "NextAction": "partial-notify", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "offlineChoice": "1" } }, "Identifier": "store-choice-msg", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "collect-name", "Errors": [{ "NextAction": "collect-name", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Attributes": { "offlineChoice": "2" } }, "Identifier": "store-choice-sched", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "collect-name", "Errors": [{ "NextAction": "collect-name", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Attributes": { "offlineChoice": "3" } }, "Identifier": "store-choice-vm", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "collect-name", "Errors": [{ "NextAction": "collect-name", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "Text": "Can I start with your name please?", "LexV2Bot": { "AliasArn": "{{LEX_TEXT_BOT_ARN}}" } },
      "Identifier": "collect-name",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "store-name",
        "Conditions": [{ "NextAction": "store-name", "Condition": { "Operator": "Equals", "Operands": ["CollectText"] } }],
        "Errors": [
          { "NextAction": "store-name", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "partial-notify", "ErrorType": "NoMatchingError" },
          { "NextAction": "partial-notify", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "customerName": "$.Lex.Slots.userInput" } }, "Identifier": "store-name", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "format-name", "Errors": [{ "NextAction": "format-name", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": {
        "LambdaFunctionARN": "{{NOTIFY_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": { "action": "format-name", "customerName": "$.Attributes.customerName" }
      },
      "Identifier": "format-name", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "store-formatted-name", "Errors": [{ "NextAction": "greet-by-name", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "Attributes": { "customerName": "$.External.formattedName" } }, "Identifier": "store-formatted-name", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "greet-by-name", "Errors": [{ "NextAction": "greet-by-name", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "Text": "Nice to meet you, $.Attributes.customerName! I'm A-A-bot." },
      "Identifier": "greet-by-name",
      "Type": "MessageParticipant",
      "Transitions": { "NextAction": "collect-contact", "Errors": [{ "NextAction": "collect-contact", "ErrorType": "NoMatchingError" }] }
    },

    {
      "Parameters": { "Text": "Please provide your 10-digit phone number, your e-mail address, or both:", "LexV2Bot": { "AliasArn": "{{LEX_TEXT_BOT_ARN}}" } },
      "Identifier": "collect-contact",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "store-contact",
        "Conditions": [{ "NextAction": "store-contact", "Condition": { "Operator": "Equals", "Operands": ["CollectText"] } }],
        "Errors": [
          { "NextAction": "store-contact", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "partial-notify", "ErrorType": "NoMatchingError" },
          { "NextAction": "partial-notify", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "contactInfo": "$.Lex.Slots.userInput" } }, "Identifier": "store-contact", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "route-after-contact", "Errors": [{ "NextAction": "route-after-contact", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "ComparisonValue": "$.Attributes.offlineChoice" },
      "Identifier": "route-after-contact",
      "Type": "Compare",
      "Transitions": {
        "NextAction": "collect-message",
        "Conditions": [
          { "NextAction": "collect-message", "Condition": { "Operator": "Equals", "Operands": ["1"] } },
          { "NextAction": "sched-intro",     "Condition": { "Operator": "Equals", "Operands": ["2"] } },
          { "NextAction": "vm-check-channel",  "Condition": { "Operator": "Equals", "Operands": ["3"] } }
        ],
        "Errors": [{ "NextAction": "collect-message", "ErrorType": "NoMatchingCondition" }]
      }
    },

    {
      "Parameters": { "Text": "What would you like the message to say?", "LexV2Bot": { "AliasArn": "{{LEX_TEXT_BOT_ARN}}" } },
      "Identifier": "collect-message",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "store-message",
        "Conditions": [{ "NextAction": "store-message", "Condition": { "Operator": "Equals", "Operands": ["CollectText"] } }],
        "Errors": [
          { "NextAction": "store-message", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "partial-notify", "ErrorType": "NoMatchingError" },
          { "NextAction": "partial-notify", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "customerMessage": "$.Lex.Slots.userInput" } }, "Identifier": "store-message", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "send-notify", "Errors": [{ "NextAction": "send-notify", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": {
        "LambdaFunctionARN": "{{NOTIFY_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "notifyType": "message", "contactId": "$.ContactId", "channel": "$.Channel",
          "endpoint": "$.CustomerEndpoint.Address", "customerName": "$.Attributes.customerName",
          "contactInfo": "$.Attributes.contactInfo", "customerMessage": "$.Attributes.customerMessage",
          "visitorIp": "$.Attributes.visitorIp"
        }
      },
      "Identifier": "send-notify", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "msg-confirm", "Errors": [{ "NextAction": "msg-confirm", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "Text": "Got it — your message has been sent to Aaron. He'll be in touch soon." }, "Identifier": "msg-confirm", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "thank-you", "Errors": [{ "NextAction": "thank-you", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "ComparisonValue": "$.Channel" },
      "Identifier": "vm-check-channel",
      "Type": "Compare",
      "Transitions": {
        "NextAction": "vm-collect-message",
        "Conditions": [
          { "NextAction": "vm-voice-record-on", "Condition": { "Operator": "Equals", "Operands": ["VOICE"] } }
        ],
        "Errors": [{ "NextAction": "vm-collect-message", "ErrorType": "NoMatchingCondition" }]
      }
    },

    { "Parameters": { "RecordingBehavior": { "RecordedParticipants": ["Customer"] } }, "Identifier": "vm-voice-record-on", "Type": "UpdateContactRecordingBehavior",
      "Transitions": { "NextAction": "vm-voice-greeting", "Errors": [], "Conditions": [] } },

    { "Parameters": { "Text": "Please leave your message for Aaron after the tone. Press any key when you're done, or just hang up." }, "Identifier": "vm-voice-greeting", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "vm-voice-wait", "Errors": [{ "NextAction": "vm-voice-wait", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "Text": " ", "StoreInput": "False", "InputTimeLimitSeconds": "120" },
      "Identifier": "vm-voice-wait", "Type": "GetParticipantInput",
      "Transitions": {
        "NextAction": "vm-voice-confirm",
        "Conditions": [],
        "Errors": [
          { "NextAction": "vm-voice-confirm", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "vm-voice-confirm", "ErrorType": "NoMatchingError" },
          { "NextAction": "vm-voice-confirm", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Text": "Got it — Aaron will listen to your message and get back to you." }, "Identifier": "vm-voice-confirm", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "vm-notify", "Errors": [{ "NextAction": "vm-notify", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "Text": "Go ahead — what would you like Aaron to know?", "LexV2Bot": { "AliasArn": "{{LEX_TEXT_BOT_ARN}}" } },
      "Identifier": "vm-collect-message",
      "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "vm-store-message",
        "Conditions": [{ "NextAction": "vm-store-message", "Condition": { "Operator": "Equals", "Operands": ["CollectText"] } }],
        "Errors": [
          { "NextAction": "vm-store-message", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "partial-notify", "ErrorType": "NoMatchingError" },
          { "NextAction": "partial-notify", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "customerMessage": "$.Lex.Slots.userInput" } }, "Identifier": "vm-store-message", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "vm-msg", "Errors": [{ "NextAction": "vm-msg", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Text": "Got it — I've passed your message along to Aaron. He'll reach out soon." }, "Identifier": "vm-msg", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "vm-notify", "Errors": [{ "NextAction": "vm-notify", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": {
        "LambdaFunctionARN": "{{NOTIFY_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "notifyType": "voicemail_request", "contactId": "$.ContactId", "channel": "$.Channel",
          "endpoint": "$.CustomerEndpoint.Address", "customerName": "$.Attributes.customerName",
          "contactInfo": "$.Attributes.contactInfo", "customerMessage": "$.Attributes.customerMessage",
          "visitorIp": "$.Attributes.visitorIp"
        }
      },
      "Identifier": "vm-notify", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "thank-you", "Errors": [{ "NextAction": "thank-you", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "Text": "Let me grab Aaron's calendar. One sec..." }, "Identifier": "sched-intro", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "sched-list-slots", "Errors": [{ "NextAction": "sched-list-slots", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "LambdaFunctionARN": "{{SCHEDULE_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": { "action": "list-slots", "minDate": "$.Attributes.scheduleMinDate" } },
      "Identifier": "sched-list-slots", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "sched-check-count", "Errors": [{ "NextAction": "sched-error", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "ComparisonValue": "$.External.slotsCount" }, "Identifier": "sched-check-count", "Type": "Compare",
      "Transitions": { "NextAction": "sched-show-menu", "Conditions": [{ "NextAction": "sched-no-slots", "Condition": { "Operator": "Equals", "Operands": ["0"] } }],
        "Errors": [{ "NextAction": "sched-show-menu", "ErrorType": "NoMatchingCondition" }] } },

    { "Parameters": { "Text": "Aaron's calendar is fully booked right now. Try the contact page at aaronrohrbacher.com/contact and he'll find time." }, "Identifier": "sched-no-slots", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "thank-you", "Errors": [{ "NextAction": "thank-you", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Text": "$.External.slotsMenuText" }, "Identifier": "sched-show-menu", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "sched-pick-slot", "Errors": [{ "NextAction": "sched-pick-slot", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "Text": "Reply 1–5 to book, or 0 to see more.", "LexV2Bot": { "AliasArn": "{{LEX_MENU_BOT_ARN}}" } },
      "Identifier": "sched-pick-slot", "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "sched-error",
        "Conditions": [
          { "NextAction": "sched-page-fwd", "Condition": { "Operator": "Equals", "Operands": ["SelectZero"] } },
          { "NextAction": "sched-store-1",  "Condition": { "Operator": "Equals", "Operands": ["SelectOne"] } },
          { "NextAction": "sched-store-2",  "Condition": { "Operator": "Equals", "Operands": ["SelectTwo"] } },
          { "NextAction": "sched-store-3",  "Condition": { "Operator": "Equals", "Operands": ["SelectThree"] } },
          { "NextAction": "sched-store-4",  "Condition": { "Operator": "Equals", "Operands": ["SelectFour"] } },
          { "NextAction": "sched-store-5",  "Condition": { "Operator": "Equals", "Operands": ["SelectFive"] } }
        ],
        "Errors": [
          { "NextAction": "sched-error", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "sched-error", "ErrorType": "NoMatchingError" },
          { "NextAction": "sched-error", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "slotChoice": "1" } }, "Identifier": "sched-store-1", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "sched-book", "Errors": [{ "NextAction": "sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "2" } }, "Identifier": "sched-store-2", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "sched-book", "Errors": [{ "NextAction": "sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "3" } }, "Identifier": "sched-store-3", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "sched-book", "Errors": [{ "NextAction": "sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "4" } }, "Identifier": "sched-store-4", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "sched-book", "Errors": [{ "NextAction": "sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "5" } }, "Identifier": "sched-store-5", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "sched-book", "Errors": [{ "NextAction": "sched-book", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Attributes": { "scheduleMinDate": "$.External.lastSlotIso" } }, "Identifier": "sched-page-fwd", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "sched-list-slots", "Errors": [{ "NextAction": "sched-list-slots", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "LambdaFunctionARN": "{{SCHEDULE_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "action": "book-slot", "slotChoice": "$.Attributes.slotChoice",
          "customerName": "$.Attributes.customerName", "schedulerEmail": "$.Attributes.contactInfo",
          "slot1Iso": "$.External.slot1Iso", "slot2Iso": "$.External.slot2Iso",
          "slot3Iso": "$.External.slot3Iso", "slot4Iso": "$.External.slot4Iso", "slot5Iso": "$.External.slot5Iso"
        } },
      "Identifier": "sched-book", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "sched-check-ok", "Errors": [{ "NextAction": "sched-error", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "ComparisonValue": "$.External.bookingOk" }, "Identifier": "sched-check-ok", "Type": "Compare",
      "Transitions": { "NextAction": "sched-error", "Conditions": [{ "NextAction": "sched-notify", "Condition": { "Operator": "Equals", "Operands": ["true"] } }],
        "Errors": [{ "NextAction": "sched-error", "ErrorType": "NoMatchingCondition" }] } },

    {
      "Parameters": {
        "LambdaFunctionARN": "{{NOTIFY_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "notifyType": "schedule", "contactId": "$.ContactId", "channel": "$.Channel",
          "endpoint": "$.CustomerEndpoint.Address", "customerName": "$.Attributes.customerName",
          "contactInfo": "$.Attributes.contactInfo", "visitorIp": "$.Attributes.visitorIp",
          "bookedTime": "$.External.bookedTime"
        }
      },
      "Identifier": "sched-notify", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "sched-done", "Errors": [{ "NextAction": "sched-done", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "Text": "Done — you're booked! Aaron will reach out to confirm." }, "Identifier": "sched-done", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "thank-you", "Errors": [{ "NextAction": "thank-you", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": { "Text": "That didn't go through. Try the contact page at aaronrohrbacher.com/contact and Aaron will sort it out." }, "Identifier": "sched-error", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "thank-you", "Errors": [{ "NextAction": "thank-you", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": { "LambdaFunctionARN": "{{NOTIFY_LAMBDA_ARN}}", "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "notifyType": "partial", "contactId": "$.ContactId", "channel": "$.Channel",
          "endpoint": "$.CustomerEndpoint.Address", "customerName": "$.Attributes.customerName",
          "contactInfo": "$.Attributes.contactInfo", "visitorIp": "$.Attributes.visitorIp"
        } },
      "Identifier": "partial-notify", "Type": "InvokeLambdaFunction",
      "Transitions": { "NextAction": "thank-you", "Errors": [{ "NextAction": "thank-you", "ErrorType": "NoMatchingError" }] }
    },

    { "Parameters": { "Text": "Thank you very much for visiting Aaron's site. Take care!" }, "Identifier": "thank-you", "Type": "MessageParticipant",
      "Transitions": { "NextAction": "disconnect", "Errors": [{ "NextAction": "disconnect", "ErrorType": "NoMatchingError" }] } },

    { "Parameters": {}, "Identifier": "disconnect", "Type": "DisconnectParticipant", "Transitions": {} }

  ]
}
