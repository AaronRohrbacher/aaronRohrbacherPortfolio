        "Errors": [{ "NextAction": "q-sched-error", "ErrorType": "NoMatchingCondition" }, { "NextAction": "q-sched-error", "ErrorType": "NoMatchingError" }, { "NextAction": "q-sched-error", "ErrorType": "InputTimeLimitExceeded" }] } },

    { "Parameters": { "Attributes": { "slotChoice": "1" } }, "Identifier": "q-sched-store-1", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "q-sched-book", "Errors": [{ "NextAction": "q-sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "2" } }, "Identifier": "q-sched-store-2", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "q-sched-book", "Errors": [{ "NextAction": "q-sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "3" } }, "Identifier": "q-sched-store-3", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "q-sched-book", "Errors": [{ "NextAction": "q-sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "4" } }, "Identifier": "q-sched-store-4", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "q-sched-book", "Errors": [{ "NextAction": "q-sched-book", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "slotChoice": "5" } }, "Identifier": "q-sched-store-5", "Type": "UpdateContactAttributes", "Transitions": { "NextAction": "q-sched-book", "Errors": [{ "NextAction": "q-sched-book", "ErrorType": "NoMatchingError" }] } },

