    { "Parameters": { "Text": "Can I start with your name please?", "LexV2Bot": { "AliasArn": "{{LEX_TEXT_BOT_ARN}}" } },
      "Identifier": "q-collect-name", "Type": "ConnectParticipantWithLexBot",
      "Transitions": { "NextAction": "q-store-name",
        "Conditions": [{ "NextAction": "q-store-name", "Condition": { "Operator": "Equals", "Operands": ["CollectText"] } }],
        "Errors": [{ "NextAction": "q-store-name", "ErrorType": "NoMatchingCondition" }, { "NextAction": "q-partial-notify", "ErrorType": "NoMatchingError" }, { "NextAction": "q-partial-notify", "ErrorType": "InputTimeLimitExceeded" }] } },

