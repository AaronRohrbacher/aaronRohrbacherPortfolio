          { "NextAction": "q-vm-check-channel",  "Condition": { "Operator": "Equals", "Operands": ["3"] } }
        ],
        "Errors": [{ "NextAction": "q-collect-message", "ErrorType": "NoMatchingCondition" }] } },

    { "Parameters": { "Text": "What would you like the message to say?", "LexV2Bot": { "AliasArn": "{{LEX_TEXT_BOT_ARN}}" } },
