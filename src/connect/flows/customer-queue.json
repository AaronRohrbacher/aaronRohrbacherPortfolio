          { "NextAction": "q-sched-store-2",  "Condition": { "Operator": "Equals", "Operands": ["SelectTwo"] } },
          { "NextAction": "q-sched-store-3",  "Condition": { "Operator": "Equals", "Operands": ["SelectThree"] } },
          { "NextAction": "q-sched-store-4",  "Condition": { "Operator": "Equals", "Operands": ["SelectFour"] } },
          { "NextAction": "q-sched-store-5",  "Condition": { "Operator": "Equals", "Operands": ["SelectFive"] } }
