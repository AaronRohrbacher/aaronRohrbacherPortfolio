    "hash": {}
  },
  "Actions": [

    { "Parameters": { "TimeLimitSeconds": "30" }, "Identifier": "queue-wait", "Type": "Wait",
      "Transitions": { "NextAction": "stepped-away-menu",
        "Conditions": [{ "NextAction": "stepped-away-menu", "Condition": { "Operator": "Equals", "Operands": ["WaitCompleted"] } }],
        "Errors": [{ "NextAction": "stepped-away-menu", "ErrorType": "NoMatchingError" }] } },

    {
      "Parameters": {
        "Text": "I'm sorry, Aaron has stepped away. Can I:\n\n1. Take a message? I'll e-mail it to him.\n2. Schedule a 30-minute call with Aaron at a convenient time for you?",
        "LexV2Bot": { "AliasArn": "{{LEX_MENU_BOT_ARN}}" }
      },
      "Identifier": "stepped-away-menu", "Type": "ConnectParticipantWithLexBot",
      "Transitions": {
        "NextAction": "q-partial-notify",
        "Conditions": [
          { "NextAction": "q-store-choice-msg",   "Condition": { "Operator": "Equals", "Operands": ["SelectOne"] } },
          { "NextAction": "q-store-choice-sched", "Condition": { "Operator": "Equals", "Operands": ["SelectTwo"] } }
        ],
        "Errors": [
          { "NextAction": "q-partial-notify", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "q-partial-notify", "ErrorType": "NoMatchingError" },
          { "NextAction": "q-partial-notify", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

    { "Parameters": { "Attributes": { "offlineChoice": "1" } }, "Identifier": "q-store-choice-msg", "Type": "UpdateContactAttributes",
      "Transitions": { "NextAction": "q-collect-name", "Errors": [{ "NextAction": "q-collect-name", "ErrorType": "NoMatchingError" }] } },
    { "Parameters": { "Attributes": { "offlineChoice": "2" } }, "Identifier": "q-store-choice-sched", "Type": "UpdateContactAttributes",
