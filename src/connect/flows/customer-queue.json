      "Identifier": "q-vm-voice-wait", "Type": "GetParticipantInput",
      "Transitions": {
        "NextAction": "q-vm-voice-confirm",
        "Conditions": [],
        "Errors": [
          { "NextAction": "q-vm-voice-confirm", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "q-vm-voice-confirm", "ErrorType": "NoMatchingError" },
          { "NextAction": "q-vm-voice-confirm", "ErrorType": "InputTimeLimitExceeded" }
        ]
      }
    },

